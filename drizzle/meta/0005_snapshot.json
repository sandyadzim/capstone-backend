          "value": "\"damage_reports\".\"created_by_user_id\" = \"damage_reports\".\"reported_by_user_id\""
        },
        "ck_damage_reports_title_nonblank": {
          "name": "ck_damage_reports_title_nonblank",
          "value": "length(btrim(\"damage_reports\".\"title\")) > 0"
        },
        "ck_damage_reports_description_nonblank": {
          "name": "ck_damage_reports_description_nonblank",
          "value": "length(btrim(\"damage_reports\".\"description\")) > 0"
        },
        "ck_damage_reports_category": {
          "name": "ck_damage_reports_category",
          "value": "\"damage_reports\".\"category\" IN ('AC', 'ELECTRICAL', 'PLUMBING', 'FURNITURE', 'BUILDING', 'OTHER')"
        },
        "ck_damage_reports_proposed_priority": {
          "name": "ck_damage_reports_proposed_priority",
          "value": "\"damage_reports\".\"proposed_priority\" IS NULL OR \"damage_reports\".\"proposed_priority\" IN ('LOW', 'MEDIUM', 'HIGH')"
        },
        "ck_damage_reports_final_priority": {
          "name": "ck_damage_reports_final_priority",
          "value": "\"damage_reports\".\"final_priority\" IS NULL OR \"damage_reports\".\"final_priority\" IN ('LOW', 'MEDIUM', 'HIGH')"
        },
        "ck_damage_reports_status": {
          "name": "ck_damage_reports_status",
          "value": "\"damage_reports\".\"status\" IN ('REPORTED', 'VERIFIED', 'REJECTED', 'ASSIGNED', 'IN_PROGRESS', 'COMPLETED', 'CLOSED')"
        },
        "ck_damage_reports_final_priority_by_status": {
          "name": "ck_damage_reports_final_priority_by_status",
          "value": "(\"damage_reports\".\"status\" = 'REPORTED' AND \"damage_reports\".\"final_priority\" IS NULL) OR (\"damage_reports\".\"status\" <> 'REPORTED' AND \"damage_reports\".\"final_priority\" IS NOT NULL)"
        },
        "ck_damage_reports_rejection_details": {
          "name": "ck_damage_reports_rejection_details",
          "value": "\"damage_reports\".\"status\" <> 'REJECTED' OR (\"damage_reports\".\"reviewed_by_user_id\" IS NOT NULL AND \"damage_reports\".\"rejection_reason\" IS NOT NULL AND length(btrim(\"damage_reports\".\"rejection_reason\")) > 0)"
        },
        "ck_damage_reports_closure_details": {
          "name": "ck_damage_reports_closure_details",
          "value": "(\"damage_reports\".\"status\" = 'CLOSED' AND \"damage_reports\".\"closed_at\" IS NOT NULL AND \"damage_reports\".\"closed_by_user_id\" IS NOT NULL) OR (\"damage_reports\".\"status\" <> 'CLOSED' AND \"damage_reports\".\"closed_at\" IS NULL AND \"damage_reports\".\"closed_by_user_id\" IS NULL)"
        }
      },
      "isRLSEnabled": false
    },
